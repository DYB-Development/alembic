<fieldset>
  <% if category.present? %>
    <p class="text-xs font-semibold uppercase tracking-wider text-accent-600 mb-2"><%= category %></p>
  <% end %>
  <legend class="ks-heading text-xl mb-5 leading-snug"><%= question.text %></legend>
  <div class="space-y-3">
    <% question.choices.each do |choice| %>
      <label class="block cursor-pointer">
        <%= radio_button_tag "answers[#{question.id}]", choice.value, false, class: "peer sr-only", onchange: (local_assigns.fetch(:sends_on_choice, true) ? "this.form.requestSubmit()" : nil) %>
        <span class="ks-radio-card ks-radio-card-highlight flex items-start gap-3 transition hover:border-(color:--ks-color-hover-border)">
          <% if shows_values %>
            <span class="text-xs font-semibold uppercase tracking-wider text-accent-600 border border-accent-200 rounded px-2 py-0.5 shrink-0 mt-0.5"><%= choice.value %></span>
          <% end %>
          <span class="text-gray-900">
            <%= choice.label.presence || choice.value %>
            <% if choice.hint.present? %>
              <small class="block text-gray-500"><%= choice.hint %></small>
            <% end %>
          </span>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
