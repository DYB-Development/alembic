<% content_for(:title, @guide.headline) %>
<% content_for :head do %>
  <%= javascript_include_tag "alembic/one_page", defer: true %>
<% end %>

<section class="py-20 md:py-28">
  <div class="max-w-2xl mx-auto px-6">
    <% if (starting_over = start_over_path) %>
      <%= link_to "← Start over", starting_over, class: "text-sm text-accent-600 hover:text-accent-700" %>
    <% end %>

    <%= form_with url: flow_step_path(visited_flow_address), method: :get, data: { turbo: false, one_page: true }, class: "mt-6" do %>
      <% @questions.each_with_index do |question, index| %>
        <div data-one-page-question>
          <div class="mb-8"><%= ui_progress(value: index, max: @questions.size, label: "Question #{index + 1} of #{@questions.size}") %></div>
          <%= render "alembic/flows/question", question: question, category: step_category(question), shows_values: shows_answer_values?, sends_on_choice: false %>
          <% if index.positive? %>
            <button type="button" data-one-page-previous hidden class="mt-6 ks-tone-muted cursor-pointer text-sm underline underline-offset-2 hover:text-(color:--ks-color-text) dark:hover:text-(color:--ks-color-text-dark)">← Previous</button>
          <% end %>
        </div>
      <% end %>

      <div data-one-page-ready class="mt-8">
        <p class="text-gray-600 mb-5">That's every question.</p>
        <div class="flex items-center gap-4">
        <%= ui_button(label: "See my results", type: :submit) %>
        <button type="button" data-one-page-previous hidden class="ks-tone-muted cursor-pointer text-sm underline underline-offset-2 hover:text-(color:--ks-color-text) dark:hover:text-(color:--ks-color-text-dark)">← Previous</button>
        </div>
      </div>
    <% end %>
  </div>
</section>
