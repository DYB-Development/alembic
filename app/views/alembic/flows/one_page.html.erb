<% content_for(:title, @guide.headline) %>
<% content_for :head do %>
  <%= javascript_include_tag "alembic/one_page", defer: true %>
<% end %>

<section class="py-20 md:py-28">
  <div class="max-w-2xl mx-auto px-6">
    <%= link_to "← Start over", flow_start_path(@guide.slug), class: "text-sm text-accent-600 hover:text-accent-700" %>

    <%= form_with url: flow_step_path(@guide.slug), method: :get, data: { turbo: false, one_page: true }, class: "mt-6" do %>
      <% @questions.each_with_index do |question, index| %>
        <div data-one-page-question>
          <div class="flex items-center justify-between text-sm text-gray-500 mb-2">
            <span>Question <%= index + 1 %> of <%= @questions.size %></span>
          </div>
          <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden mb-8">
            <i class="block h-full bg-accent-600 rounded-full transition-all" style="width:<%= (index * 100.0 / @questions.size).round %>%"></i>
          </div>
          <%= render "alembic/flows/question", question: question, category: step_category(question), shows_values: shows_answer_values?, sends_on_choice: false %>
          <% if index.positive? %>
            <button type="button" data-one-page-previous hidden class="mt-6 cursor-pointer text-sm text-gray-500 underline underline-offset-2 hover:text-gray-900">← Previous</button>
          <% end %>
        </div>
      <% end %>

      <div data-one-page-ready class="mt-8">
        <p class="text-gray-600 mb-5">That's every question.</p>
        <div class="flex items-center gap-4">
        <button type="submit" class="inline-flex items-center justify-center font-semibold rounded-lg bg-accent-600 text-white hover:bg-accent-500 px-6 py-3 cursor-pointer">See my results</button>
        <button type="button" data-one-page-previous hidden class="cursor-pointer text-sm text-gray-500 underline underline-offset-2 hover:text-gray-900">← Previous</button>
        </div>
      </div>
    <% end %>
  </div>
</section>
