<% content_for(:title, "Complete") %>

<% starting_over = start_over_path %>

<%= ui_page(max_width: :md) do %>
  <%= ui_page_header(title: "That's everything", subtitle: "Thanks — here's what you told us") do |header| %>
    <% if starting_over %>
      <% header.action do %>
        <%= ui_button(label: "Start over", href: starting_over, variant: :secondary) %>
      <% end %>
    <% end %>
  <% end %>

  <% if @outputs.any? %>
    <%= ui_section do %>
      <div class="space-y-10">
        <% @outputs.each do |output| %>
          <div data-output="<%= output.id %>">
            <%= alembic_default_result(output, @outputs) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if (link = finish_link) %>
    <%= ui_section do %>
      <%= ui_button(label: link[:label], href: link[:url]) %>
    <% end %>
  <% end %>

  <% if Alembic.lead_address %>
    <%= ui_section do %>
      <%= alembic_lead_block(slug: summary_values["slug"], note: summary_values["note"]) %>
    <% end %>
  <% end %>

  <%= ui_section(title: @outputs.any? ? "What you told us" : nil) do %>
    <ul class="divide-y divide-(color:--ks-color-divider) border-y border-(color:--ks-color-divider) dark:divide-(color:--ks-color-divider-dark) dark:border-(color:--ks-color-divider-dark)">
      <% @answered.each do |step, value| %>
        <li data-answer="<%= step %>" class="flex items-baseline justify-between gap-6 py-3">
          <span class="ks-tone-muted"><%= @guide.question_text(step) %></span>
          <span class="flex shrink-0 items-center gap-2 font-(weight:--ks-font-weight-medium) ks-tone-neutral">
            <%= @guide.choice_label(step, value) %>
            <% if answered_right?(step, value) %>
              <svg aria-label="Right" role="img" class="size-5 ks-tone-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
