<% content_for(:title, "Complete") %>

<% starting_over = flow_start_path(@guide.slug) %>

<%= ui_page(max_width: :md) do %>
  <%= ui_page_header(title: "That's everything", subtitle: "Thanks — here's what you told us") do |header| %>
    <% header.action do %>
      <%= ui_button(label: "Start over", href: starting_over, variant: :secondary) %>
    <% end %>
  <% end %>

  <% if @outputs.any? %>
    <%= ui_section do %>
      <div class="space-y-10">
        <% @outputs.each do |output| %>
          <div data-output="<%= output.id %>">
            <%= alembic_default_result(output) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= ui_section(title: @outputs.any? ? "What you told us" : nil) do %>
    <ul class="divide-y divide-(color:--ks-color-divider) border-y border-(color:--ks-color-divider) dark:divide-(color:--ks-color-divider-dark) dark:border-(color:--ks-color-divider-dark)">
      <% @answered.each do |step, value| %>
        <li data-answer="<%= step %>" class="flex items-baseline justify-between gap-6 py-3">
          <span class="ks-tone-muted"><%= @guide.question_text(step) %></span>
          <span class="shrink-0 font-(weight:--ks-font-weight-medium) ks-tone-neutral"><%= @guide.choice_label(step, value) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
