<% intro_page = Alembic::Flow::Summaries.new(@flow).intro_page %>
<% if intro_page&.live_version %>
  <% content_for(:title, @flow.title.presence || @flow.slug) %>
  <% content_for :head do %>
    <%= stylesheet_link_tag "ks_blocks" %>
  <% end %>

  <section class="py-20 md:py-28">
    <div class="max-w-2xl mx-auto px-6">
      <%= drawn_page(intro_page, values: intro_values) %>
    </div>
  </section>
<% else %>
  <% content_for(:title, intro_values["title"]) %>

  <section class="py-20 md:py-28">
    <div class="max-w-2xl mx-auto px-6">
      <%= alembic_hero_block(headline: intro_values["title"], text: intro_values["summary"]) %>
      <%= alembic_facts_block(question_count: intro_values["question_count"]) { "{question_count} | questions" } %>
      <%= alembic_start_block(label: @flow.start_label.presence || "Start →", start_path: intro_values["start_path"],
            starts_a_run: intro_values["starts_a_run"]) %>
    </div>
  </section>
<% end %>
