<% intro_page = Alembic::Flow::Summaries.new(@flow).intro_page %>
<% if intro_page&.live_version %>
  <% content_for(:title, @flow.title.presence || @flow.slug) %>
  <% content_for :head do %>
    <%= stylesheet_link_tag "ks_blocks" %>
  <% end %>

  <%= drawn_page(intro_page, values: intro_values) %>
<% else %>
<% content_for(:title, @flow.title.presence || @flow.slug) %>

<%= ui_page(max_width: :md) do %>
  <%= ui_page_header(title: @flow.title.presence || @flow.slug, subtitle: flow_summary(@flow)) %>

  <%= ui_section do %>
    <div class="flex flex-wrap items-center gap-3">
      <% if @flow.each_step? && @flow.definition.present? && !previewing? %>
        <%= ui_form(action: alembic.flow_runs_path(@flow.slug), method: :post) do %>
          <%= ui_button(label: @flow.start_label.presence || "Start", type: :submit) %>
        <% end %>
      <% else %>
        <%= ui_button(label: @flow.start_label.presence || "Start", href: first_step_path(@flow.slug)) %>
      <% end %>
    </div>
  <% end %>
<% end %>
<% end %>
