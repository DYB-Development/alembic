<% content_for(:title, @guide.headline) %>

<section class="py-20 md:py-28">
  <div class="max-w-2xl mx-auto px-6">
    <% if (starting_over = start_over_path) %>
      <%= link_to "← Start over", starting_over, class: "text-sm text-(color:--ks-color-link) hover:text-(color:--ks-color-link-hover) dark:text-(color:--ks-color-link-dark) dark:hover:text-(color:--ks-color-link-hover-dark)" %>
    <% end %>

    <% answered = @answers.size %>
    <% questions = answered + @guide.questions_left(@answers) %>
    <div class="mt-6 mb-8"><%= ui_progress(value: answered, max: [ questions, 1 ].max, label: "Question #{answered + 1} of #{questions}") %></div>

    <% if flash[:alert] %>
      <div class="mt-6"><%= ui_alert(message: flash[:alert], type: :error) %></div>
    <% end %>

    <% if @waiting %>
      <p class="mt-6 ks-tone-neutral">Waiting for <%= @waiting %>.</p>
    <% else %>
      <%= form_with url: step_form[:url], method: step_form[:method], data: { turbo: false }, class: "mt-6" do %>
        <%= hidden_field_tag :asked, @question.id %>
        <% if carries_answers? %>
          <% @answers.each do |key, value| %>
            <%= hidden_field_tag "answers[#{key}]", value %>
          <% end %>
        <% end %>

        <% if single_choice?(@question) %>
          <%= render "alembic/flows/question", question: shown(@question), category: step_category(@question),
                shows_values: shows_answer_values?, chosen: chosen_answer(@question) %>
        <% else %>
          <%= render @drawing, step: shown(@question), chosen: chosen_answer(@question) %>
        <% end %>

        <div class="mt-8 flex items-center gap-4">
          <%= ui_button(label: "Next", type: :submit) unless single_choice?(@question) %>
          <% if @answers.any? %>
            <button type="submit" name="back" value="1" formnovalidate class="ks-tone-muted cursor-pointer text-sm underline underline-offset-2 hover:text-(color:--ks-color-text) dark:hover:text-(color:--ks-color-text-dark)">← Back</button>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
