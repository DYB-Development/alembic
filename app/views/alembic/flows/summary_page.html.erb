<% content_for :head do %>
  <%= stylesheet_link_tag "ks_blocks" %>
<% end %>

<section class="py-20 md:py-28">
  <div class="max-w-2xl mx-auto px-6">
    <%= drawn_page(@summary_page, values: summary_values) %>
    <% if (link = finish_link) %>
      <div class="mt-10">
        <%= ui_button(label: link[:label], href: link[:url]) %>
      </div>
    <% end %>
  </div>
</section>
