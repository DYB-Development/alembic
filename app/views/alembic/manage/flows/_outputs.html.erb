<%= ui_section(title: "What it works out") do %>
  <% uncategorised.each do |question| %>
    <div class="mb-4" data-problem>
      <%= ui_alert(type: :warning, message: "#{EasyFlow::Steps::Question.asked(question)} has no category, so it counts toward no category's score.") %>
    </div>
  <% end %>
  <% outputs.each_with_index do |output, index| %>
    <% field = "flow[outputs][#{index}]" %>
    <div data-output-editor="<%= output["id"] %>" class="mb-6">
      <%= hidden_field_tag "#{field}[id]", output["id"], id: nil %>
      <%= hidden_field_tag "#{field}[type]", output["type"], id: nil %>
      <p class="mb-1 text-sm ks-tone-muted"><%= output["type"] %></p>
      <%= ui_input(name: "#{field}[label]", value: output["label"]) %>
      <% if output["type"] == "band" %>
        <% (Array(output["bands"]) + [ {} ]).each_with_index do |band, position| %>
          <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3" data-band>
            <%= ui_input(name: "#{field}[bands][#{position}][name]", value: band["name"], placeholder: "Name") %>
            <%= ui_input(name: "#{field}[bands][#{position}][ceiling]", value: band["ceiling"], type: :number, placeholder: "Up to, below") %>
            <%= ui_input(name: "#{field}[bands][#{position}][description]", value: band["description"], placeholder: "Description") %>
          </div>
        <% end %>
      <% end %>
      <% if output["type"] == "outcome" %>
        <label class="ks-label mb-1 mt-3">Rules, first that holds wins</label>
        <%= ui_textarea(name: "#{field}[rules_text]", value: alembic_rules_text(output["rules"]), rows: 4) %>
        <% (Array(output["entries"]) + [ {} ]).each_with_index do |entry, position| %>
          <% place = "#{field}[entries][#{position}]" %>
          <% texts = alembic_entry_texts(entry) %>
          <div class="mt-4 space-y-2 border-t border-(color:--ks-color-divider) pt-4" data-outcome-entry>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              <%= ui_input(name: "#{place}[key]", value: entry["key"], placeholder: "Key the rules name") %>
              <%= ui_input(name: "#{place}[label]", value: entry["label"], placeholder: "Label, such as Tier 1") %>
              <%= ui_input(name: "#{place}[name]", value: entry["name"], placeholder: "Name") %>
              <%= ui_input(name: "#{place}[tagline]", value: entry["tagline"], placeholder: "Tagline") %>
            </div>
            <%= ui_textarea(name: "#{place}[facts_text]", value: texts["facts_text"], rows: 3, placeholder: "Facts, one per line: Label | value") %>
            <%= ui_textarea(name: "#{place}[sections_text]", value: texts["sections_text"], rows: 4, placeholder: "Sections, one per line: Heading | text | result note") %>
            <%= ui_textarea(name: "#{place}[steps_text]", value: texts["steps_text"], rows: 6, placeholder: "Steps: a title line, then code, with --- between steps") %>
          </div>
        <% end %>
      <% end %>
      <% if output["type"] == "lowest" %>
        <label class="ks-label mb-1 mt-3">How many to name</label>
        <%= ui_input(name: "#{field}[count]", value: output["count"], type: :number) %>
        <% categories.each do |category| %>
          <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3" data-category-copy>
            <p class="text-sm"><%= category %></p>
            <%= ui_input(name: "#{field}[copy][#{category}][miss]", value: output.dig("copy", category, "miss"), placeholder: "What it misses") %>
            <%= ui_input(name: "#{field}[copy][#{category}][cost]", value: output.dig("copy", category, "cost"), placeholder: "What it costs") %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
