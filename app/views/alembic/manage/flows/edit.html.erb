<%= ui_page(max_width: :lg) do %>
  <p class="mb-4">
    <%= link_to "← Back to the flow", easy_flow.manage_flow_path(@flow), class: "text-sm text-(color:--ks-color-link) hover:text-(color:--ks-color-link-hover) dark:text-(color:--ks-color-link-dark) dark:hover:text-(color:--ks-color-link-hover-dark)" %>
  </p>

  <%= ui_form_page(title: "Edit details", back_url: easy_flow.manage_flow_path(@flow)) %>

  <%= ui_form(action: easy_flow.manage_flow_path(@flow), method: :patch) do %>
    <%= ui_section(title: "How this is introduced") do %>
      <label class="ks-label mb-1">Title</label>
      <%= ui_input(name: "flow[title]", value: @flow.title) %>

      <label class="ks-label mb-1 mt-4">Summary</label>
      <%= ui_textarea(name: "flow[summary]", value: @summary, rows: 4) %>

      <label class="ks-label mb-1 mt-4">Start label</label>
      <%= ui_input(name: "flow[start_label]", value: @flow.start_label) %>
    <% end %>

    <%= ui_section(title: "Where this finishes") do %>
      <%= ui_select(name: "flow[summary_page_id]", selected: @summary_page&.id,
            include_blank: "Alembic's default summary page",
            options: @published_pages.map { |page| [ page.name, page.id ] }) %>
    <% end %>

    <%= ui_section(title: "What this keeps of a run") do %>
      <%= ui_select(name: "flow[persists]", selected: @flow.persists,
            options: [ [ "Nothing", "unsaved" ],
                       [ "Every answer as it is given", "each_step" ],
                       [ "The whole run once it finishes", "on_finish" ] ]) %>
    <% end %>

    <%= ui_button(label: "Save", type: :submit) %>
  <% end %>
<% end %>
