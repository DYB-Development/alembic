<% content_for :head do %>
  <%= stylesheet_link_tag "alembic/page_builder" %>
  <%= javascript_include_tag "keystone_ui/react", defer: true %>
  <%= javascript_include_tag "alembic/page_builder", defer: true %>
<% end %>

<%= ui_form(action: alembic.publish_manage_page_path(@page), method: :post) do %>
  <%= ui_button(label: "Publish", type: :submit, variant: :secondary) %>
<% end %>

<% choices = Alembic::Page::Preview.choices_for(@page) %>
<% if choices.any? %>
  <%= ui_form(action: alembic.preview_manage_page_path(@page), method: :patch) do %>
    <label class="ks-label mb-1">Preview with</label>
    <%= ui_select(name: "choice", options: choices, selected: session.dig(:alembic_preview, @page.id.to_s), include_blank: "Sample results") %>
    <%= ui_button(label: "Show", type: :submit, variant: :secondary) %>
  <% end %>
<% end %>

<%= ui_panel do %>
  <%= react_ui("alembic/page-builder", @payload.merge(token: form_authenticity_token)) %>
<% end %>

<%= block_contents(@page.blocks) do |block| %>
  <%= render "alembic/manage/pages/block_content", block: block, page: @page %>
<% end %>
