<div>
  <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4"><%= heading %></h2>
  <div class="space-y-4">
    <% categories.each do |category| %>
      <%= ui_panel(padding: :lg) do %>
        <h3 class="text-lg font-semibold text-gray-900 mb-1.5"><%= category["name"] %></h3>
      <% end %>
    <% end %>
  </div>
</div>
