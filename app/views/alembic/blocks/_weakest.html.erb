<div>
  <h2 class="ks-caption mb-4"><%= heading %></h2>
  <div class="space-y-4">
    <% categories.each do |category| %>
      <%= ui_panel(padding: :lg) do %>
        <h3 class="ks-heading text-lg mb-1.5"><%= category["name"] %></h3>
        <p class="ks-tone-neutral mb-2"><%= category["miss"] %></p>
        <p class="text-sm text-(color:--ks-color-link) dark:text-(color:--ks-color-link-dark)"><span class="font-semibold"><%= cost_label %></span> <%= category["cost"] %></p>
      <% end %>
    <% end %>
  </div>
</div>
