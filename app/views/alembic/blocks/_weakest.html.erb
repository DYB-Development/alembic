<div>
  <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4"><%= heading %></h2>
  <div class="space-y-4">
    <% categories.each do |category| %>
      <%= ui_panel(padding: :lg) do %>
        <h3 class="text-lg font-semibold text-gray-900 mb-1.5"><%= category["name"] %></h3>
        <p class="text-gray-700 mb-2"><%= category["miss"] %></p>
        <p class="text-sm text-accent-700"><span class="font-semibold"><%= cost_label %></span> <%= category["cost"] %></p>
      <% end %>
    <% end %>
  </div>
</div>
