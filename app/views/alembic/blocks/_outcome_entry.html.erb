<%= ui_panel(padding: :lg) do %>
  <details id="outcome-<%= entry["key"] %>" class="group" <%= "open" if open %>>
    <summary class="flex items-start gap-3 cursor-pointer list-none">
      <% if entry["label"].present? %>
        <span class="text-xs font-semibold uppercase tracking-wider text-(color:--ks-color-link) dark:text-(color:--ks-color-link-dark) border border-(color:--ks-color-tint-border) rounded px-2 py-1 shrink-0"><%= entry["label"] %></span>
      <% end %>
      <span class="flex-1">
        <span class="ks-heading block text-lg"><%= entry["name"] %></span>
        <span class="ks-tone-muted block text-sm"><%= entry["tagline"] %></span>
      </span>
      <span class="text-(color:--ks-color-icon) dark:text-(color:--ks-color-icon-dark) transition group-open:rotate-90">&#9656;</span>
    </summary>

    <div class="mt-5 space-y-5">
      <% if Array(entry["facts"]).any? %>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-px overflow-hidden rounded-lg bg-(color:--ks-color-border) dark:bg-(color:--ks-color-border-dark)">
          <% Array(entry["facts"]).each do |label, value| %>
            <div class="bg-(color:--ks-color-raised) dark:bg-(color:--ks-color-raised-dark) p-3"><dt class="ks-tone-muted text-xs uppercase tracking-wide mb-1"><%= label %></dt><dd class="ks-tone-neutral text-sm"><%= value %></dd></div>
          <% end %>
        </dl>
      <% end %>

      <% Array(entry["sections"]).each do |section| %>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider <%= section["note"].present? ? "ks-tone-danger" : "text-(color:--ks-color-link) dark:text-(color:--ks-color-link-dark)" %> mb-1"><%= section["heading"] %></h4>
          <p class="ks-tone-neutral"><%= section["text"] %></p>
          <% if section["note"].present? %>
            <p class="ks-tone-danger mt-1 text-sm"><span class="font-semibold">Result:</span> <%= section["note"] %></p>
          <% end %>
        </div>
      <% end %>

      <% if Array(entry["steps"]).any? %>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-(color:--ks-color-link) dark:text-(color:--ks-color-link-dark) mb-2">How to build it</h4>
          <% Array(entry["steps"]).each_with_index do |step, index| %>
            <p class="ks-tone-neutral text-sm font-semibold mt-3"><%= index + 1 %>. <%= step["title"] %></p>
            <pre class="ks-code-block mt-1 overflow-x-auto rounded-lg text-xs leading-relaxed"><code><%= step["code"] %></code></pre>
          <% end %>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
