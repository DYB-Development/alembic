<%= ui_panel(padding: :lg) do %>
  <details id="outcome-<%= entry["key"] %>" class="group" <%= "open" if open %>>
    <summary class="flex items-start gap-3 cursor-pointer list-none">
      <% if entry["label"].present? %>
        <span class="text-xs font-semibold uppercase tracking-wider text-accent-600 border border-accent-200 rounded px-2 py-1 shrink-0"><%= entry["label"] %></span>
      <% end %>
      <span class="flex-1">
        <span class="block text-lg font-semibold text-gray-900"><%= entry["name"] %></span>
        <span class="block text-sm text-gray-500"><%= entry["tagline"] %></span>
      </span>
      <span class="text-gray-400 transition group-open:rotate-90">&#9656;</span>
    </summary>

    <div class="mt-5 space-y-5">
      <% if Array(entry["facts"]).any? %>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-px overflow-hidden rounded-lg bg-gray-200">
          <% Array(entry["facts"]).each do |label, value| %>
            <div class="bg-gray-50 p-3"><dt class="text-xs uppercase tracking-wide text-gray-400 mb-1"><%= label %></dt><dd class="text-sm text-gray-900"><%= value %></dd></div>
          <% end %>
        </dl>
      <% end %>

      <% Array(entry["sections"]).each do |section| %>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider <%= section["note"].present? ? "text-red-600" : "text-accent-600" %> mb-1"><%= section["heading"] %></h4>
          <p class="text-gray-700"><%= section["text"] %></p>
          <% if section["note"].present? %>
            <p class="mt-1 text-sm text-red-700"><span class="font-semibold">Result:</span> <%= section["note"] %></p>
          <% end %>
        </div>
      <% end %>

      <% if Array(entry["steps"]).any? %>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-accent-600 mb-2">How to build it</h4>
          <% Array(entry["steps"]).each_with_index do |step, index| %>
            <p class="text-sm font-semibold text-gray-900 mt-3"><%= index + 1 %>. <%= step["title"] %></p>
            <pre class="mt-1 overflow-x-auto rounded-lg bg-gray-900 p-4 text-xs leading-relaxed text-gray-100"><code><%= step["code"] %></code></pre>
          <% end %>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
