<div>
  <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4"><%= heading %></h2>
  <ul class="divide-y divide-gray-100 border-y border-gray-100">
    <% answers.each do |question, answer| %>
      <li class="flex items-baseline justify-between gap-6 py-3">
        <span class="text-gray-600"><%= question %></span>
        <span class="shrink-0 font-semibold text-gray-900"><%= answer %></span>
      </li>
    <% end %>
  </ul>
</div>
