<div>
  <h2 class="ks-caption mb-4"><%= heading %></h2>
  <ul class="divide-y divide-(color:--ks-color-divider) border-y border-(color:--ks-color-divider) dark:divide-(color:--ks-color-divider-dark) dark:border-(color:--ks-color-divider-dark)">
    <% answers.each do |question, answer| %>
      <li class="flex items-baseline justify-between gap-6 py-3">
        <span class="ks-tone-muted"><%= question %></span>
        <span class="ks-tone-neutral shrink-0 font-semibold"><%= answer %></span>
      </li>
    <% end %>
  </ul>
</div>
