<%= ui_panel(padding: :lg) do %>
  <h2 class="ks-heading text-xl mb-2"><%= heading %></h2>
  <% if blurb.present? %>
    <p class="ks-tone-muted mb-5"><%= blurb %></p>
  <% end %>
  <%= form_with url: address, method: :post, class: "flex flex-col sm:flex-row gap-3" do %>
    <%= render Alembic.lead_fields_partial if Alembic.lead_fields_partial %>
    <%= hidden_field_tag "slug", slug %>
    <%= hidden_field_tag "note", note %>
    <div class="flex-1">
      <%= ui_input(name: "email", type: :email, placeholder: placeholder) %>
    </div>
    <%= ui_button(label: button, type: :submit) %>
  <% end %>
<% end %>
