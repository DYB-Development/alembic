<div>
  <% if kicker.present? %>
    <p class="text-xs font-semibold uppercase tracking-widest text-(color:--ks-color-link) dark:text-(color:--ks-color-link-dark) mb-3"><%= kicker %></p>
  <% end %>
  <h1 class="ks-hero-title text-3xl md:text-4xl tracking-tight mb-3"><%= headline %></h1>
  <% if text.present? %>
    <p class="ks-hero-subtitle text-lg mb-6"><%= text %></p>
  <% end %>
</div>
