<div>
  <% if kicker.present? %>
    <p class="text-xs font-semibold uppercase tracking-widest text-accent-600 mb-3"><%= kicker %></p>
  <% end %>
  <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 mb-3"><%= headline %></h1>
  <% if text.present? %>
    <p class="text-lg text-gray-600 mb-6"><%= text %></p>
  <% end %>
</div>
