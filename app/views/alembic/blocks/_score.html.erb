<div class="text-center">
  <p class="text-xs font-semibold uppercase tracking-widest text-(color:--ks-color-link) dark:text-(color:--ks-color-link-dark) mb-4"><%= kicker %></p>
  <div class="ks-tone-neutral text-7xl md:text-8xl font-bold tracking-tight"><%= value.nil? ? "—" : "#{value}%" %></div>
  <% if caption.present? %>
    <p class="ks-tone-muted text-sm mt-1"><%= caption %></p>
  <% end %>
</div>
