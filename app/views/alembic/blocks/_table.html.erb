<div class="overflow-x-auto">
  <table class="w-full text-sm text-left">
    <thead>
      <tr class="border-b border-(color:--ks-color-border) dark:border-(color:--ks-color-border-dark)">
        <% heading.each do |cell| %>
          <th class="ks-tone-neutral py-2 pr-4 font-semibold"><%= cell %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr class="border-b border-(color:--ks-color-divider) dark:border-(color:--ks-color-divider-dark)">
          <% row.each do |cell| %>
            <td class="ks-tone-muted py-2 pr-4"><%= cell %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
