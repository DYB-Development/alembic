<div>
  <h2 class="ks-caption mb-4"><%= heading %></h2>
  <% shares.each do |name, share| %>
    <div class="flex items-center gap-3 mb-2.5">
      <span class="ks-tone-muted text-sm w-44 shrink-0"><%= name %></span>
      <span class="ks-progress-track flex-1 h-2 overflow-hidden">
        <span class="block h-full rounded-full <%= alembic_tone(share) %>" style="width:<%= [ share.to_i, 4 ].max %>%"></span>
      </span>
    </div>
  <% end %>
</div>
