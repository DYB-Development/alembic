<div>
  <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4"><%= heading %></h2>
  <% shares.each do |name, share| %>
    <div class="flex items-center gap-3 mb-2.5">
      <span class="text-sm text-gray-600 w-44 shrink-0"><%= name %></span>
      <span class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
        <span class="block h-full rounded-full <%= alembic_tone(share) %>" style="width:<%= [ share.to_i, 4 ].max %>%"></span>
      </span>
    </div>
  <% end %>
</div>
